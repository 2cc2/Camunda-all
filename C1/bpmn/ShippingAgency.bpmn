<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_sa" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Custom" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_SA" name="Shipping Agency" isExecutable="true">
    <bpmn:startEvent id="StartEvent_SA">
      <bpmn:outgoing>Flow_SA_start_to_manifest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_send_manifest" name="Send Manifest to Customs">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-manifest-to-customs" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SA_start_to_manifest</bpmn:incoming>
      <bpmn:outgoing>Flow_SA_manifest_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_SA">
      <bpmn:incoming>Flow_SA_manifest_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SA_start_to_manifest" sourceRef="StartEvent_SA" targetRef="Activity_send_manifest" />
    <bpmn:sequenceFlow id="Flow_SA_manifest_to_end" sourceRef="Activity_send_manifest" targetRef="EndEvent_SA" />
  </bpmn:process>
</bpmn:definitions>
