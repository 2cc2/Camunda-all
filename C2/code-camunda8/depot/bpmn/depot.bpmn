<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_depot_export_contract" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:collaboration id="Collaboration_depot_export">
    <bpmn:participant id="Participant_depot" name="Depot" processRef="depot-export-contract" />
    <bpmn:participant id="Participant_environment" name="Environment" processRef="Process_depot_environment" />
    <bpmn:messageFlow id="MessageFlow_ask_for_ctn" name="ask for CTN" sourceRef="Participant_environment" targetRef="StartEvent_depot" />
    <bpmn:messageFlow id="MessageFlow_empty_ctn" name="empty CTN to Transport" sourceRef="Task_send_empty_ctn" targetRef="Participant_environment" />
    <bpmn:messageFlow id="MessageFlow_ctn_arrival" name="CTN arrival info to SA" sourceRef="Task_send_arrival_info" targetRef="Participant_environment" />
    <bpmn:messageFlow id="MessageFlow_outbound_receipt" name="outbound CTN to Depot" sourceRef="Participant_environment" targetRef="Event_outbound_receipt" />
    <bpmn:messageFlow id="MessageFlow_outbound_ctn" name="outbound CTN to CT" sourceRef="Task_send_outbound_ctn" targetRef="Participant_environment" />
  </bpmn:collaboration>
  <bpmn:process id="depot-export-contract" name="Depot Export Contract" isExecutable="true">
    <bpmn:startEvent id="StartEvent_depot" name="CTN request received">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_ask_for_ctn" messageRef="Message_ask_for_ctn" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_send_empty_ctn" name="send Empty CTN to Transport">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-empty-ctn-to-transport" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_send_arrival_info" name="send CTN arrival info to SA">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-ctn-arrival-info-to-sa" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="Event_outbound_receipt" name="Outbound CTN from Transport received">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_outbound_receipt" messageRef="Message_outbound_ctn_to_depot" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_send_outbound_ctn" name="send Outbound CTN to Container Terminal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-outbound-ctn-to-ct" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_depot">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="StartEvent_depot" targetRef="Task_send_empty_ctn" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_send_empty_ctn" targetRef="Task_send_arrival_info" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_send_arrival_info" targetRef="Event_outbound_receipt" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_outbound_receipt" targetRef="Task_send_outbound_ctn" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_send_outbound_ctn" targetRef="EndEvent_depot" />
  </bpmn:process>

  <bpmn:message id="Message_ask_for_ctn" name="ask-for-ctn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_outbound_ctn_to_depot" name="outbound-ctn-to-depot">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Process_depot_environment" isExecutable="false" />

  <bpmndi:BPMNDiagram id="Diagram_depot_export_contract">
    <bpmndi:BPMNPlane id="Plane_depot_export_contract" bpmnElement="Collaboration_depot_export">
      <bpmndi:BPMNShape id="Shape_participant_depot" bpmnElement="Participant_depot" isHorizontal="true">
        <dc:Bounds x="110" y="360" width="1060" height="150" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_participant_environment" bpmnElement="Participant_environment" isHorizontal="true">
        <dc:Bounds x="110" y="70" width="1060" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="StartEvent_depot">
        <dc:Bounds x="152" y="413" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="126" y="456" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_empty_ctn" bpmnElement="Task_send_empty_ctn">
        <dc:Bounds x="260" y="391" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_arrival_info" bpmnElement="Task_send_arrival_info">
        <dc:Bounds x="470" y="391" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_outbound_receipt" bpmnElement="Event_outbound_receipt">
        <dc:Bounds x="680" y="413" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="648" y="456" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_send_outbound_ctn" bpmnElement="Task_send_outbound_ctn">
        <dc:Bounds x="770" y="391" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end" bpmnElement="EndEvent_depot">
        <dc:Bounds x="1010" y="413" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="188" y="431" />
        <di:waypoint x="260" y="431" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="420" y="431" />
        <di:waypoint x="470" y="431" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="630" y="431" />
        <di:waypoint x="680" y="431" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="716" y="431" />
        <di:waypoint x="770" y="431" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="960" y="431" />
        <di:waypoint x="1010" y="431" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_message_ask_for_ctn" bpmnElement="MessageFlow_ask_for_ctn">
        <di:waypoint x="170" y="270" />
        <di:waypoint x="170" y="413" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="332" width="94" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_message_empty_ctn" bpmnElement="MessageFlow_empty_ctn">
        <di:waypoint x="340" y="391" />
        <di:waypoint x="340" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="300" y="320" width="80" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_message_ctn_arrival" bpmnElement="MessageFlow_ctn_arrival">
        <di:waypoint x="550" y="391" />
        <di:waypoint x="550" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="509" y="320" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_message_outbound_receipt" bpmnElement="MessageFlow_outbound_receipt">
        <di:waypoint x="698" y="270" />
        <di:waypoint x="698" y="413" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="656" y="320" width="86" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_message_outbound_ctn" bpmnElement="MessageFlow_outbound_ctn">
        <di:waypoint x="865" y="391" />
        <di:waypoint x="865" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="824" y="320" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
