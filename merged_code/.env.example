# Camunda 8 Run (本地) 默认连接配置
# 将本文件复制为 .env 即可。如本地 c8run 端口不同，请改成实际值。

# Zeebe gRPC 地址（不带 protocol 时代码会自动加 grpc:// 表示明文连接）
ZEEBE_ADDRESS=localhost:26500

# Zeebe REST 地址（不要带 /v2，SDK 会自动拼接）
ZEEBE_REST_ADDRESS=http://localhost:8085

# 关闭 OAuth（c8run 默认未启用 auth）
CAMUNDA_AUTH_STRATEGY=NONE
CAMUNDA_OAUTH_DISABLED=true

# 流程实例启动时使用的 senderId 前缀（可选）
SENDER_PREFIX=CAMUNDA-COLLAB
