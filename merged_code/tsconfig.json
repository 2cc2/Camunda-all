{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "outDir": "dist"
  },
  "include": ["shared/**/*.ts", "workers/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "_archive", "dist"]
}
